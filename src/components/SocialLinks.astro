---
import WhatsAppMark from './WhatsAppMark.astro';
const instagram = 'https://www.instagram.com/burgerplanet/';
const tiktok = 'https://www.tiktok.com/@burgerplanet';
---
<div class="social-links" role="group" aria-label="Redes de Burger Planet">
  <a data-social="instagram" role="link" aria-label="Instagram" href={instagram} data-default-url={instagram} title="Instagram" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
  </a>
  <a data-social="tiktok" role="link" aria-label="TikTok" href={tiktok} data-default-url={tiktok} title="TikTok" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.1 2h3.2a4.5 4.5 0 0 0 4.3 4.4v3.2a7.6 7.6 0 0 1-4.3-1.3v7a6.1 6.1 0 1 1-6.2-6.1l.8.1v3.3a2.9 2.9 0 1 0 2.2 2.8V2Z"/></svg>
  </a>
  <a data-social="whatsapp" role="link" aria-label="WhatsApp" aria-disabled="true" title="WhatsApp sin configurar" target="_blank" rel="noopener noreferrer">
    <WhatsAppMark />
  </a>
</div>
